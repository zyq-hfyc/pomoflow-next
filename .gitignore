# --- Rust / Cargo ---
/target/
**/*.rs.bk

# 本机工具链指向(由各机器 owner 各自配置,绝不入仓)
/.cargo/config.toml
/.cargo/config.local.toml

# Cargo.lock:P1.6 起 commit 进仓。
# 原策略"workspace 不提交、只有 bin crate 才提交"已不成立:
#   ci.yml / release.yml 跑 `--locked`,没 lockfile 直接挂;
#   且 workspace 现在已有 bin crate(apps/desktop + tools/migrate-v1),
#   按上游惯例(tauri-action / rust-libs)整 workspace 提交一份 lockfile
#   才能保证 release build 可复现。

# --- Tauri ---
/apps/desktop/target/
/apps/desktop/gen/

# --- 前端(Web UI,装到 apps/desktop/ui/) ---
/apps/desktop/ui/node_modules/
/apps/desktop/ui/dist/
/apps/desktop/ui/.vite/
/apps/desktop/ui/tsconfig.tsbuildinfo

# 桌面端根的 tauri-cli npm wrapper(P1.7 加,只装 CLI 二进制)
/apps/desktop/node_modules/
/apps/desktop/package-lock.json

# --- Python 残留(以防从 v1 仓库误拷过来) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/

# --- 数据库 / 用户数据(绝不进仓库) ---
*.db
*.db-journal
*.sqlite
*.sqlite3
*.bak
*.bak.*

# --- 日志 / 临时文件 ---
*.log
*.tmp
*.swp
*~

# --- IDE / 编辑器 ---
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- 测试 / 覆盖率 ---
coverage/
*.lcov
.pytest_cache/
.grcov/

# 用户个人任务清单,不进入版本控制
docs/提示词.txt

# sync-server 运行环境(容器/.env 提供,不入库)
services/sync-server/.env

# 本地交叉编译的 Linux 二进制(build-local.sh 产物,随部署包分发,不入库)
services/sync-server/bin/

# 本地保留的发布产物(安装包/部署包),不入库
artifacts/

# Android 机器本地配置(SDK/flutter 路径,各机器 owner 自配)
apps/mobile/android/local.properties
apps/mobile/android/.gradle/

# release 签名(密码/keystore 绝不入仓)
apps/mobile/android/key.properties
apps/mobile/android/pomoflow-release.keystore
