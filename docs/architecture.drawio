        <mxCell id="s3" value="&lt;b&gt;对象存储 S3 / OSS&lt;/b&gt;&lt;br&gt;数据库备份 / 导入导出" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="950" y="610" width="210" height="95" as="geometry" />
