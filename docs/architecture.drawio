        </mxCell>
        <mxCell id="redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;缓存 / 会话 / 分布式锁&lt;br&gt;Token 黑名单" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="610" width="190" height="95" as="geometry" />
        </mxCell>
        <mxCell id="nats" value="&lt;b&gt;NATS&lt;/b&gt; 事件总线&lt;br&gt;服务解耦 / 异步通知 / 削峰" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="610" width="220" height="95" as="geometry" />
