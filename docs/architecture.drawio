<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram name="PomoFlow 目标架构" id="pomoflow-arch">
    <mxGraphModel dx="1400" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 背景分组(底层) -->
        <mxCell id="bg1" value="① 客户端层 Client  —  Local-first:每端本地 SQLite,离线全功能;登录后按需同步" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="bg2" value="② 云端微服务层  —  按语言擅长领域选型 · 弹性可扩展(K8s + HPA 自动扩缩)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="1320" height="300" as="geometry" />
        </mxCell>
        <mxCell id="bg3" value="③ 数据与基础设施" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="1320" height="150" as="geometry" />
        </mxCell>

        <!-- 客户端 -->
        <mxCell id="m" value="移动端&lt;br&gt;&lt;b&gt;Flutter + Drift&lt;/b&gt;&lt;br&gt;Dart · iOS / 安卓 / 鸿蒙&lt;br&gt;本地 SQLite(离线全功能)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="90" y="75" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d" value="桌面端&lt;br&gt;&lt;b&gt;Tauri 2 + Rust&lt;/b&gt;(业务逻辑写 Rust)&lt;br&gt;Web UI · rusqlite · 内嵌 pomoflow_core&lt;br&gt;Win / macOS / Linux 三端一致" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="470" y="75" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="管理后台(内网 · 不对用户开放)&lt;br&gt;&lt;b&gt;React + Ant Design Pro&lt;/b&gt;&lt;br&gt;TypeScript · 数据统计 / 会员权限" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="970" y="75" width="330" height="90" as="geometry" />
        </mxCell>

        <!-- 共享 crate(桥接节点) -->
        <mxCell id="core" value="⭐ &lt;b&gt;pomoflow-rs · core crate(Rust,桌面 + 云端共享)&lt;/b&gt;  —  域模型 / 同步协议 / LWW 合并 / 校验:两端同一份代码,合并算法零漂移" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="250" y="193" width="900" height="32" as="geometry" />
        </mxCell>

        <!-- 网关 -->
        <mxCell id="gw" value="API Gateway · &lt;b&gt;APISIX&lt;/b&gt;   —   统一入口 · JWT 校验 · 限流 · 路由" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="520" y="275" width="360" height="46" as="geometry" />
        </mxCell>

        <!-- 云端服务行 -->
        <mxCell id="auth" value="认证服务&lt;br&gt;&lt;b&gt;Auth · Rust&lt;/b&gt;&lt;br&gt;axum · JWT / 会话" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sync" value="同步服务&lt;br&gt;&lt;b&gt;Sync · Rust&lt;/b&gt; ⭐&lt;br&gt;axum + tokio + sqlx&lt;br&gt;Push/Pull · LWW 合并&lt;br&gt;内嵌 pomoflow_core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;strokeWidth=3;" vertex="1" parent="1">
