        <!-- 图例 -->
        <mxCell id="legend" value="&lt;b&gt;语言图例(按领域选型):&lt;/b&gt;  &lt;font color='#9673a6'&gt;■ Rust&lt;/font&gt; 性能/安全(Sync · Auth · 桌面后端 · core crate)   &lt;font color='#82b366'&gt;■ Go&lt;/font&gt; CRUD/事件高并发(User · Membership · Notification · Admin BFF)   &lt;font color='#d6b656'&gt;■ Python&lt;/font&gt; 数据/统计(Analytics)   &lt;font color='#6c8ebf'&gt;■ Dart / TS&lt;/font&gt; 客户端      |      &lt;b&gt;同步:&lt;/b&gt; 本地 SQLite ↔ 云端 增量 Push/Pull + LWW + UUID(登录后按需同步)" style="text;html=1;strokeColor=#b0b0b0;fillColor=#fafafa;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
