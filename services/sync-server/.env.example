# 复制为 .env 后修改;绝不把真实 .env 提交进仓库
POSTGRES_PASSWORD=pomoflow-dev

# 单账号 MVP 认证(桌面端"服务器设置"里填同一对值)
# SYNC_USER_ID 必须是 UUID(与桌面端 meta.user_id 对齐,便于后续账号绑定)
SYNC_USER_ID=00000000-0000-4000-8000-000000000001
SYNC_TOKEN=dev-token-change-me

# 账号体系(P1b):HS256 签名密钥,设置后启用 register/login/refresh/logout。
# 生成:openssl rand -hex 32(64 个十六进制字符)。
# 不设置 = 纯静态 Token 模式(与 P1a 行为完全一致);一旦启用请妥善保管,
# 更换密钥会使所有已登录客户端强制重新登录。
# JWT_SECRET=change-me-openssl-rand-hex-32

# 验证码 HMAC pepper(P1d):建议独立生成 openssl rand -hex 32;
# 未设置时回落使用 JWT_SECRET(启动日志会告警)。
# CODE_PEPPER=change-me-openssl-rand-hex-32

# 邮件发送(P1d):配置 SMTP_HOST 即启用真发信;不配置 = 日志模式
# (验证码打印在服务端日志,VM 本地联调用)。
# QQ 邮箱:smtp.qq.com / 465;163:smtp.163.com / 465。
# USER=邮箱地址,PASS=授权码(不是登录密码;QQ 邮箱在 设置→账号→POP3/SMTP 开启后生成)。
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=you@example.com
# SMTP_PASS=your-smtp-auth-code
# SMTP_FROM=you@example.com

# ---- 发布分发(ADR-013;腾讯云生产批接入,经 deploy/docker-compose.prod.yml 转发)----
# 以下 4 变量 base compose 未转发,只在叠加 prod override 时生效。
# ⚠️ compose 只把列在 environment 里的变量传进容器,漏转发 = .env 配了也不生效。

# 服务间通道密钥:admin-bff 与运维脚本(first-release.sh)调 /internal/* 用。
# 生成:openssl rand -hex 32。不设置 = 内部端点全组 403(prod override 已必配)。
# INTERNAL_SERVICE_TOKEN=change-me-openssl-rand-hex-32

# 安装包落盘目录(容器内路径;prod override 挂卷宿主 ./data/releases)。
# 不设置 = 上传端点 500 / 公开下载 404(纯同步部署不受影响);设置后启动自动建目录。
# RELEASE_FILES_DIR=/data/releases

# 安装包上传上限(字节;服务端默认 512MiB,prod override 提到 1GiB,
# 与 nginx client_max_body_size 对齐)
# MAX_RELEASE_UPLOAD_BYTES=1073741824

# 官网静态目录(容器内路径;必须绝对路径且目录已存在,启动 fail-fast 校验
# —— 首启前先上传 apps/website/dist,见 docs/腾讯云部署runbook.md)。
# 不设置 = 官网路由不挂载,行为同纯同步部署。
# WEBSITE_DIST_DIR=/data/website-dist
