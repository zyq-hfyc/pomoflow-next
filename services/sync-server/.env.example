# 复制为 .env 后修改;绝不把真实 .env 提交进仓库
POSTGRES_PASSWORD=pomoflow-dev

# 单账号 MVP 认证(桌面端"服务器设置"里填同一对值)
# SYNC_USER_ID 必须是 UUID(与桌面端 meta.user_id 对齐,便于后续账号绑定)
SYNC_USER_ID=00000000-0000-4000-8000-000000000001
SYNC_TOKEN=dev-token-change-me

# 账号体系(P1b):HS256 签名密钥,设置后启用 register/login/refresh/logout。
# 生成:openssl rand -hex 32(64 个十六进制字符)。
# 不设置 = 纯静态 Token 模式(与 P1a 行为完全一致);一旦启用请妥善保管,
# 更换密钥会使所有已登录客户端强制重新登录。
# JWT_SECRET=change-me-openssl-rand-hex-32

# 验证码 HMAC pepper(P1d):建议独立生成 openssl rand -hex 32;
# 未设置时回落使用 JWT_SECRET(启动日志会告警)。
# CODE_PEPPER=change-me-openssl-rand-hex-32

# 邮件发送(P1d):配置 SMTP_HOST 即启用真发信;不配置 = 日志模式
# (验证码打印在服务端日志,VM 本地联调用)。
# QQ 邮箱:smtp.qq.com / 465;163:smtp.163.com / 465。
# USER=邮箱地址,PASS=授权码(不是登录密码;QQ 邮箱在 设置→账号→POP3/SMTP 开启后生成)。
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=you@example.com
# SMTP_PASS=your-smtp-auth-code
# SMTP_FROM=you@example.com
